"language": "GDScript",
"path": "res://assets/stars/Stars.gd"
}, {
"base": "Control",
"class": "UIButton",
"language": "GDScript",
"path": "res://ui/UIButton.gd"
}, {
"base": "VBoxContainer",
"class": "VButtonMenu",
