"language": "GDScript",
"path": "res://ui/Scroll.gd"
}, {
"base": "RichTextEffect",
"class": "ScrollDecipher",
"language": "GDScript",
"path": "res://assets/dialog/textfx/scroll_decipher.gd"
}, {
"base": "RichTextEffect",
